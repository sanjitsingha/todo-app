{
  "expo": {
    "name": "Dooist",
    "slug": "todo-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FC5C2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dooist.sanjit"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "scheme": "todoapp",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "99e3ec8d-bc4f-4576-9a39-3921efa69e54"
      },
      "release": {
        "version": "1.1.1",
        "notes": [
          "A new dark look, built on deep, neutral grays.",
          "The Dooist orange on buttons, checkboxes and the Stats chart, and on today's date in the date strip.",
          "Calendar: connect Google Calendar, see your Google events in Today, and switch todo sync on or off.",
          "Account: see your picture and email, change your name, set a password, or delete your account.",
          "Notifications: tap the bell at the top of Profile.",
          "Delete a todo from its details, with the trash icon beside its name.",
          "Smoother swiping in the date strip and time pickers, with a steady tick.",
          "Add time now starts at the current time.",
          "Check for Updates opens its own page, with what's new in each update."
        ]
      }
    },
    "owner": "sanjit.dev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99e3ec8d-bc4f-4576-9a39-3921efa69e54"
    }
  }
}
